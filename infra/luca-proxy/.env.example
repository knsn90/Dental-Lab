# VPS'te /opt/luca-proxy/.env (chmod 600). Gerçek değerleri depoya KOYMA.
# Aynı sır Supabase secret'ı olarak da tanımlı: LUCA_PROXY_SECRET
LUCA_PROXY_SECRET=<openssl rand -hex 32>
# Test: Luca demo firmaları · Canlı: yalnız başvurusu yapılmış VKN'ler
LUCA_VKN_TEST=1234567801,8810234738
LUCA_VKN_PROD=6312098145
# Canlı IP tanımı Luca'dan gelene kadar false
LUCA_PROD_ENABLED=false
