{
  "expo": {
    "name": "Siman",
    "slug": "dental-lab-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dental-lab",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon-ios.png",
      "bundleIdentifier": "com.nexadent.app",
      "config": {
        "googleMapsApiKey": "AIzaSyAXDmge6BAruuElktwlc018fPTiFZanBlk"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "İş emri fotoğrafı çekmek, QR okutmak ve 3D yüz tarama (gülüş tasarımı için) yapmak amacıyla kamera erişimi gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Fotoğraf galerinize erişmek için izin gerekiyor.",
        "NSLocationWhenInUseUsageDescription": "Kurye teslimat takibini paylaşmak ve iş yeri giriş/çıkış (check-in) yapmak için konumunuz kullanılır.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aktif teslimat sırasında, uygulama arka planda olsa bile konumunuz teslimat takibi için paylaşılır. Yalnız taşıdığınız teslimat varken çalışır.",
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.nexadent.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "siman.app"
            },
            {
              "scheme": "https",
              "host": "www.siman.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotoğraf galerinize erişmek için izin gerekiyor.",
          "cameraPermission": "Kamera ile fotoğraf çekmek için izin gerekiyor."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "QR kod okutmak ve iş emri fotoğrafı çekmek için kamera gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1E2D56"
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aktif teslimat sırasında, uygulama arka planda olsa bile konumunuz teslimat takibi için paylaşılır. Yalnız taşıdığınız teslimat varken çalışır.",
          "locationWhenInUsePermission": "Kurye teslimat takibini paylaşmak ve iş yeri giriş/çıkış (check-in) yapmak için konumunuz kullanılır.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4eccdeb0-694f-4c00-beab-20ce1d34ef20"
      }
    }
  }
}
